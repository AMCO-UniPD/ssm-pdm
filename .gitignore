# gitignore file for the chronos-pdm project

# # Obsidian
# chronos-pdm-notes/.obsidian/
# # templates
# chronos-pdm-notes/templates/
# # daily notes
# chronos-pdm-notes/daily_notes/
# # hf_course notes
# chronos-pdm-notes/notes/hf_course/
# # git_token.md
# chronos-pdm-notes/notes/git_token.md
# # Excalidraw
# chronos-pdm-notes/Excalidraw
# # Paper
# chronos-pdm-notes/Paper

# strange nfs files
*.nfs*

# All notes in the gitignore
ssm-pdm-notes/

# Latex paper folder
SSM_PDM_Paper/
ssm_pdm_paper.zip

# wandb
wandb/

# Code inside experiments/transformers_tutorial
experiments/transformers_tutorial/

# test script for phm dataset
experiments/phm_exp/test_phm_dataset.py

# pycache
__pycache__/

.python-version

#ipynb checkpoints
.ipynb_checkpoints/

# js stuff created by MarkdownPreview
node_modules/
package-lock.json
package.json

# txt and xlsx files containing the acquisitions. Only txt.gz files will be pushed 
*.txt
*.xlsx
*.csv

# patch files
*.patch

!requirements.txt

# some file types files
*.pickle
*.pth
*.pdf
# file types generates by qmd files 
*.png
*.html
*.js
*.css
*.woff
*.zip
*.tar.gz

# ignore all the slurm related stuff
slurm_jobs/
