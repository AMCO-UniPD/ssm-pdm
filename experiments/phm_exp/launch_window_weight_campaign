#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"
python_bin="${PHM_PYTHON:-$repo_root/.venv/bin/python}"
if [[ ! -x "$python_bin" && -z "${PHM_PYTHON:-}" ]]; then
  python_bin="$HOME/ssm-pdm/.venv/bin/python"
fi
if [[ "${1:-}" == "--python" ]]; then
  python_bin="$2"
  shift 2
fi
if [[ ! -x "$python_bin" ]]; then
  printf 'Python interpreter unavailable: %s; set PHM_PYTHON or pass --python PATH\n' "$python_bin" >&2
  exit 1
fi
exec "$python_bin" "$script_dir/ablation_campaign.py" "$@"
