#!/usr/bin/env bash

script_path="train_phm_cv.py"

mode="${1:-training_no_wandb}"

source "./phm_exp_config"

echo "-------------------------------------------"
echo "Executing $script_path"
echo "-------------------------------------------"

export CUDA_VISIBLE_DEVICES=$device_num

echo "-------------------------------------------"
echo "CUDA device: $CUDA_VISIBLE_DEVICES"
echo "-------------------------------------------"

case "$mode" in
  "training")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Training script"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --use_wandb \
    --save_best_model \
    --save_outputs \
    --save_combined_outputs \
    --compute_metrics \
    --save_metrics_df

  ;;
  "training_no_wandb")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Training without wandb logging"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --save_outputs \
    --save_combined_outputs \
    --compute_metrics \
    --save_metrics_df

  ;;
  *)

  echo "mode $mode not supported"
  exit 1

  ;;
esac
