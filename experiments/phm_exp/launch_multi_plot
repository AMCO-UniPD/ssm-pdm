#!/usr/bin/env bash

script_path="multi_standard_plot.py"

source "./phm_exp_config"

echo "-------------------------------------------"
echo "Executing $script_path"
echo "-------------------------------------------"

plot_approach="${1:-windowed_quantile_weighted}"

model_names=(
  "S4D"
  "S5"
  "S4"
  "MLP"
  "Linear"
  "LSTM"
  "GRU"
  "RNN"
  "RULTransformer"
)

exp_names=()

for model_name in "${model_names[@]}"; do

  exp_name="${model_name}_${failure_type}_${plot_approach}_cv_phm_in_features"
  echo "experiment name for $model_name set to $exp_name"
  exp_names+=("$exp_name")

done

echo "-------------------------------------------"
echo "Producing multi plot for $plot_approach"
echo "-------------------------------------------"

python "$script_path" \
    --model_names "${model_names[@]}" \
    --model_name "$model_name" \
    --exp_names "${exp_names[@]}" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --failure_type "$failure_type" \
    --plot_approach "$plot_approach" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}"


