#!/usr/bin/env bash

script_path="plot_benchmark_blob.py"

source "./phm_exp_config"

echo "-------------------------------------------"
echo "Executing $script_path"
echo "-------------------------------------------"

plot_approach="${1:-windowed_quantile_weighted}"

model_names=(
  "S4"
  "S5"
  "S4D"
  "Linear"
  "MLP"
  "LSTM"
  "RNN"
  "GRU"
  "RULTransformer"
)

exp_names=()

for model_name in "${model_names[@]}"; do
  # Keep this in sync with set_exp_name in src/exp_config.py.
  exp_name="${model_name}_${failure_type}_${plot_approach}_cv_phm_in_features"
  exp_names+=("$exp_name")
  echo "exp_name for $model_name set to $exp_name"
done

python "$script_path" \
  --model_names "${model_names[@]}" \
  --exp_names "${exp_names[@]}" \
  --exp-config "config/ssm_exp_config.yaml" \
  --failure-type "$failure_type" \
  --approach "$plot_approach"
