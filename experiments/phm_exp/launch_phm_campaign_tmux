#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"
python_bin="${PHM_PYTHON:-$repo_root/.venv/bin/python}"
if [[ ! -x "$python_bin" && -z "${PHM_PYTHON:-}" ]]; then
  python_bin="$HOME/ssm-pdm/.venv/bin/python"
fi
exec "$python_bin" "$script_dir/phm_campaign.py" "$@"
