#!/usr/bin/env bash

script_path="test_business_metrics.py"

source "./phm_exp_config"

echo "-------------------------------------------"
echo "Executing $script_path"
echo "-------------------------------------------"

# model_names=("S5" "S4" "S4D" "MLP" "Linear" "LSTM" "RNN" "GRU" "Transformer" "Informer")
model_names=("S5" "S4D" "MLP" "LSTM" "mean" "median")

exp_names_padding_standard=(
    "super_benchmark_S5_flow_low_windowed_weighted"
    "super_benchmark_S4D_flow_low_windowed_weighted"
    "super_benchmark_MLP_flow_low_windowed_weighted"
    "super_benchmark_LSTM_flow_low_windowed_weighted"
    "mean"
    "median"
)

python $script_path \
    --model_names "${model_names[@]}" \
    --exp_names "${exp_names_padding_standard[@]}" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}"
