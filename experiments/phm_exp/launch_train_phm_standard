#!/usr/bin/env bash

script_path="train_phm_standard.py"

mode="${1:-training_no_wandb}"

source "./phm_exp_config"

echo "-------------------------------------------"
echo "Executing $script_path"
echo "-------------------------------------------"

case "$mode" in
  "training")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Standard Training script"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --use_wandb \
    --save_best_model \
    --save_outputs

  ;;
  "training_no_wandb")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Standard Training without wandb logging"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --save_outputs \
    --compute_metrics \
    --save_metrics_df

  ;;
  "save_outputs")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Saving outputs"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --test_script \
    --save_outputs

  ;;
  "save_combined_outputs")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Saving combined outputs"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --test_script \
    --save_combined_outputs

  ;;
  "compute_metrics")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Computing metrics"
  echo "-------------------------------------------"

  python "compute_metrics_standard.py" \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --print_summary_metrics \
    --print_mean_metrics_df \
    --save_mean_metrics_df \
    --save_metrics_df

  ;;
  "standard_plots")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Producing standard plots"
  echo "-------------------------------------------"

  python "standard_plot.py" \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num

  ;;
  *)

  echo "mode $mode not supported"
  exit 1

  ;;
esac
