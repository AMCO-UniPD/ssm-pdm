#!/usr/bin/env bash

script_path="train_phm.py"

mode="${1:-training_no_wandb}"

source "./phm_exp_config"

echo "-------------------------------------------"
echo "Executing $script_path"
echo "-------------------------------------------"

case "$mode" in
  "training")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Training script"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --use_wandb \
    --save_best_model \
    --save_outputs \
    --compute_metrics \
    --save_metrics_df

  ;;
  "training_no_wandb")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Training without wandb logging"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --save_outputs \
    --compute_metrics \
    --save_metrics_df

  ;;
  "save_outputs")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Saving outputs"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --test_script \
    --save_outputs

  ;;
  "save_outputs_run")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Saving the outputs for all the quantiles in the same run"
  echo "-------------------------------------------"

  python "save_outputs_run.py" \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num

  ;;
  "compute_metrics")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Saving the outputs for all the quantiles in the same run"
  echo "-------------------------------------------"

  python "compute_metrics.py" \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --save_metrics_df

  ;;
  "quantile_metrics")
  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Grouping metrics from different quantiles"
  echo "-------------------------------------------"


  python "quantile_metrics.py" \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --print_summary_metrics \
    --print_mean_metrics_df \
    --save_mean_metrics_df

  ;;
  "model_summary")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Computing and saving the model summary"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --test_script \
    --save_summary_dict \
    --model_summary

  ;;
  "quantile_plots")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Producing quantile plots"
  echo "-------------------------------------------"

  python "quantile_plot.py" \
    --exp_name "$exp_name" \
    --exp_config_path "config/ssm_exp_config.yaml" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --get_test_idx \
    --combined_signal_plots \
    --an_score_plot

  ;;
  *)

  echo "mode $mode not supported"
  exit 1

  ;;
esac


