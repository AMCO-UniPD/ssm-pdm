#!/usr/bin/env bash

script_path="train_phm.py"

mode="${1:-training_no_wandb}"

set -euo pipefail
source "${PHM_SHELL_CONFIG:-./phm_exp_config}"

echo "-------------------------------------------"
echo "Executing $script_path"
echo "-------------------------------------------"

export CUDA_VISIBLE_DEVICES=$device_num

echo "-------------------------------------------"
echo "CUDA device: $CUDA_VISIBLE_DEVICES"
echo "-------------------------------------------"

case "$mode" in
  "training")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Training script"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --use_wandb \
    --save_best_model \
    --save_outputs \
    --save_combined_outputs \
    --compute_metrics \
    --save_metrics_df

  ;;
  "training_no_wandb")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Training without wandb logging"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --save_outputs \
    --save_combined_outputs \
    --compute_metrics \
    --save_metrics_df

  ;;
  "save_outputs")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Saving outputs"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --test_script \
    --save_combined_outputs

  ;;
  "save_outputs_run")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Saving the outputs for all the quantiles in the same run"
  echo "-------------------------------------------"

  python "save_outputs_run.py" \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num

  ;;
  "compute_metrics")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Computing metrics"
  echo "-------------------------------------------"

  python "compute_metrics.py" \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --save_metrics_df

  ;;
  "compute_business_metrics")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Computing business metrics"
  echo "-------------------------------------------"

  python "compute_business_metrics.py" \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --save_mean_metrics_df \
    --print_mean_metrics_df

  ;;
  "print_business_metrics")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Printing business metrics"
  echo "-------------------------------------------"

  python "print_business_metrics_tables.py" \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --model_name "$model_name" \
    --failure_type "$failure_type"

  ;;
  "quantile_metrics")
  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Grouping metrics from different quantiles"
  echo "-------------------------------------------"


  python "quantile_metrics.py" \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --print_mean_metrics_df \
    --save_mean_metrics_df

  ;;
  "model_summary")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Computing and saving the model summary"
  echo "-------------------------------------------"

  python $script_path \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --test_script \
    --save_summary_dict \
    --model_summary

  ;;
  "quantile_plots")

  echo "-------------------------------------------"
  echo "mode: $mode"
  echo "Producing quantile plots"
  echo "-------------------------------------------"

  python "quantile_plot.py" \
    --exp_name "$exp_name" \
    --exp_config_path "${PHM_EXP_CONFIG:-config/ssm_exp_config.yaml}" \
    --project_name "$project_name" \
    --data_name "$data_name" \
    --model_name "$model_name" \
    --failure_type "$failure_type" \
    --train_phm_tools "${train_phm_tools[@]}" \
    --test_phm_tools "${test_phm_tools[@]}" \
    --device_num $device_num \
    --get_test_idx

  ;;
  *)

  echo "mode $mode not supported"
  exit 1

  ;;
esac


