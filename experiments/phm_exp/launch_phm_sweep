#!/usr/bin/env bash

script_path="train_phm_sweep.py"

source "./phm_exp_config"

echo "-------------------------------------------"
echo "Executing $script_path"
echo "-------------------------------------------"

python $script_path \
  --exp_config_path "config/ssm_exp_config.yaml" \
  --project_name "$project_name" \
  --data_name "$data_name" \
  --model_name "$model_name" \
  --failure_type "$failure_type" \
  --tool_type "$tool_type" \
  --phm_tools "${phm_tools[@]}" \
  --device_num $device_num \
  --wandb_entity "$wandb_entity" \
  --sweep_id "$sweep_id" \
  --continue_old_sweep


#NOTE: Options to pass to resume an old sweep
