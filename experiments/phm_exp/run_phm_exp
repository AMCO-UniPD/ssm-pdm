#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

launcher=./launch_train_phm
if python -c 'import os,yaml; c=yaml.safe_load(open(os.environ.get("PHM_EXP_CONFIG", "config/ssm_exp_config.yaml"))); raise SystemExit(0 if c.get("cv") else 1)'; then
  launcher=./launch_train_phm_cv
fi

for stage in training save_outputs_run quantile_metrics compute_business_metrics; do
  if [[ "$stage" != training ]] && python ../../src/phm_resume.py "$stage"; then
    echo "PHM resume: keeping completed stage $stage"
    continue
  fi
  echo "PHM pipeline: $stage"
  python ../../src/phm_monitor.py "$stage"
  "$launcher" "$stage"
  python ../../src/phm_resume.py "$stage" --complete
done

if [[ -n "${PHM_MONITOR_DIR:-}" ]]; then
  python ../../src/phm_monitor.py best_fold_plots
  python phm_campaign_report.py
  python ../../src/phm_resume.py best_fold_plots --complete
else
  "$launcher" quantile_plots
fi
